warpt 1
{
  imports [
    "std.math.lessThan"
    "std.math.plus"
  ]
  procedures {
    counted {
      body [
        {
          value 0
          var "held"
        }
        {
          set "held"
          value {
            call {
              arguments [
                {
                  ref "held"
                }
                {
                  ref "value"
                }
              ]
              procedure "std.math.plus"
            }
          }
        }
      ]
      parameters [
        {
          name "value"
          type "int"
        }
      ]
      result {
        ref "held"
      }
      returns "int"
    }
    entry {
      access "public"
      body [
        {
          value 0
          var "seen"
        }
        {
          let "round"
          value {
            loop {
              body [
                {
                  set "seen"
                  value {
                    call {
                      arguments [
                        1
                      ]
                      procedure "counted"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "int"
        }
      ]
      result {
        ref "seen"
      }
      returns "int"
    }
  }
  warp 1
}
