warpt 1
{
  imports [
    "Standard.Comparable.lessThan"
  ]
  procedures {
    entry {
      access "public"
      body [
        {
          let "data"
          type "App.Data"
          value {
            record {
              a 1
            }
          }
        }
        {
          value 0
          var "seen"
        }
        {
          let "round"
          value {
            loop {
              body [
                {
                  set "seen"
                  value {
                    ref "data.a"
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "Int"
        }
      ]
      result {
        ref "seen"
      }
      returns "Int"
    }
  }
  types {
    "App.Data" {
      record {
        a "Int"
      }
    }
  }
  warp 1
}
