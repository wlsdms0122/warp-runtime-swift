warpt 1
{
  imports [
    "std.logic.equal"
    "std.math.lessThan"
  ]
  procedures {
    entry {
      access "public"
      body [
        {
          let "round"
          value {
            loop {
              body [
                {
                  let "seen"
                  value {
                    ref "round.index"
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            continue null
                          }
                        }
                      ]
                      when {
                        call {
                          arguments [
                            {
                              ref "round.index"
                            }
                            1
                          ]
                          procedure "std.logic.equal"
                        }
                      }
                    }
                  }
                }
                {
                  let "kept"
                  value {
                    ref "seen"
                  }
                }
              ]
              result {
                ref "kept"
              }
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "int"
        }
      ]
      result {
        ref "round"
      }
      returns "int?"
    }
  }
  warp 1
}
