warpt 1
{
  imports [
    "std.math.lessThan"
  ]
  procedures {
    entry {
      body [
        {
          let "round"
          value {
            loop {
              body [
                {
                  let "seen"
                  value 1
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      ref "rounds"
                    }
                  }
                  of {
                    ref "round.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters {
        rounds "int"
      }
      result {
        ref "rounds"
      }
      returns "int"
    }
  }
  warp 2
}
