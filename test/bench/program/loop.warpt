warpt 1
{
  imports [
    "std.math.lessThan"
  ]
  procedures {
    entry {
      access "public"
      body [
        {
          let "round"
          value {
            loop {
              body [
                {
                  let "seen"
                  value 1
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "int"
        }
      ]
      result {
        ref "rounds"
      }
      returns "int"
    }
  }
  warp 1
}
