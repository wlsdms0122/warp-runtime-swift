warpt 1
{
  imports [
    "Standard.Collection.setting"
    "Standard.Comparable.lessThan"
    "Standard.Numeric.remainder"
    "Standard.Text.text"
  ]
  procedures {
    entry {
      access "public"
      body [
        {
          type "Dictionary<String, Int>"
          value {
            record {}
          }
          var "held"
        }
        {
          let "round"
          value {
            loop {
              body [
                {
                  set "held"
                  value {
                    call {
                      arguments [
                        {
                          ref "held"
                        }
                        {
                          call {
                            arguments [
                              {
                                call {
                                  arguments [
                                    {
                                      ref "round.index"
                                    }
                                    100
                                  ]
                                  procedure "Standard.Numeric.remainder"
                                }
                              }
                            ]
                            procedure "Standard.Text.text"
                          }
                        }
                        1
                      ]
                      procedure "Standard.Collection.setting"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "Int"
        }
      ]
      result {
        ref "held"
      }
      returns "Dictionary<String, Int>"
    }
  }
  warp 1
}
