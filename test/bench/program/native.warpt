warpt 1
{
  imports [
    "std.math.lessThan"
    "std.math.plus"
  ]
  procedures {
    entry {
      body [
        {
          let "one"
          value 1
        }
        {
          let "round"
          value {
            loop {
              body [
                {
                  let "sum"
                  value {
                    call {
                      arguments {
                        value 1
                      }
                      of {
                        ref "one"
                      }
                      procedure "std.math.plus"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      ref "rounds"
                    }
                  }
                  of {
                    ref "round.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters {
        rounds "int"
      }
      result {
        ref "one"
      }
      returns "int"
    }
  }
  warp 1
}
