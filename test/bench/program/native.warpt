warpt 1
{
  imports [
    "std.math.lessThan"
    "std.math.plus"
  ]
  procedures {
    entry {
      access "public"
      body [
        {
          let "one"
          value 1
        }
        {
          let "round"
          value {
            loop {
              body [
                {
                  let "sum"
                  value {
                    call {
                      arguments [
                        {
                          ref "one"
                        }
                        1
                      ]
                      procedure "std.math.plus"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "int"
        }
      ]
      result {
        ref "one"
      }
      returns "int"
    }
  }
  warp 1
}
