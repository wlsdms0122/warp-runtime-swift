warpt 1
{
  imports [
    "Standard.Comparable.lessThan"
  ]
  procedures {
    "App.read" {
      parameters [
        {
          name "account"
          type "App.Account"
        }
      ]
      result {
        ref "account.balance"
      }
      returns "Int"
    }
    entry {
      access "public"
      body [
        {
          let "account"
          value {
            record {
              balance 1
            }
          }
        }
        {
          value 0
          var "seen"
        }
        {
          let "round"
          value {
            loop {
              body [
                {
                  set "seen"
                  value {
                    call {
                      arguments [
                        {
                          ref "account"
                        }
                      ]
                      procedure "App.read"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "Int"
        }
      ]
      result {
        ref "seen"
      }
      returns "Int"
    }
  }
  types {
    "App.Account" {
      record {
        balance "Int"
      }
    }
  }
  warp 1
}
