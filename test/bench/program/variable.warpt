warpt 1
{
  imports [
    "Standard.Comparable.lessThan"
    "Standard.Numeric.plus"
  ]
  procedures {
    entry {
      access "public"
      body [
        {
          value 0
          var "count"
        }
        {
          let "round"
          value {
            loop {
              body [
                {
                  set "count"
                  value {
                    call {
                      arguments [
                        {
                          ref "count"
                        }
                        1
                      ]
                      procedure "Standard.Numeric.plus"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "Int"
        }
      ]
      result {
        ref "count"
      }
      returns "Int"
    }
  }
  warp 1
}
