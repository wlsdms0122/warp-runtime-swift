warpt 1
{
  imports [
    "Standard.Collection.map"
    "Standard.Comparable.lessThan"
  ]
  procedures {
    entry {
      access "public"
      body [
        {
          let "items"
          value [
            1
          ]
        }
        {
          let "round"
          value {
            loop {
              body [
                {
                  let "mapped"
                  value {
                    call {
                      arguments [
                        {
                          ref "items"
                        }
                        {
                          closure {
                            parameters [
                              {
                                name "item"
                                type "Int"
                              }
                            ]
                            result {
                              ref "item"
                            }
                          }
                        }
                      ]
                      procedure "Standard.Collection.map"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "round.index"
                    }
                    {
                      ref "rounds"
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      parameters [
        {
          name "rounds"
          type "Int"
        }
      ]
      result {
        ref "items"
      }
      returns "Array<Int>"
    }
  }
  warp 1
}
