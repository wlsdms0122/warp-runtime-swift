(warp 1)
(import Standard.Comparable.lessThan)

(procedure entry
  (access public)
  (parameter rounds (type Int))
  (returns Int)
  (body
    (var seen 0)
    (let round
      (loop
        (while (call Standard.Comparable.lessThan (path round (field index)) rounds))
        (body
          (set seen (call identity 1)))))
    (return seen)))

(procedure identity
  (parameter value (type Int))
  (returns Int)
  (body
    (return value)))
