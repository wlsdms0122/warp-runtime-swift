(warp 1)
(import Standard.Comparable.lessThan)
(import Standard.Numeric.plus)

(procedure entry
  (access public)
  (parameter rounds (type Int))
  (returns Int)
  (body
    (var count 0)
    (let round
      (loop
        (while (call Standard.Comparable.lessThan (path round (field index)) rounds))
        (body
          (set count (call Standard.Numeric.plus count 1)))))
    (return count)))
